<Project Sdk="Microsoft.NET.Sdk">
  <!-- The add-on's own logic (settings, the invited-list decision, the idle rule, the feed text)
       compiled WITHOUT the game, MelonLoader or the mod, and checked on this machine's .NET.
       No test framework: `dotnet run` prints one line per failure and exits 1 on any. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SkipBuildPathLeakCheck>true</SkipBuildPathLeakCheck>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Doorman\Core\*.cs" LinkBase="Core" />
  </ItemGroup>
</Project>
