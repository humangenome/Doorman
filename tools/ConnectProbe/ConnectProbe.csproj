<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for "a player starts to connect": it opens a connection to a Schedule I game
       server at the network layer (the same library the game uses) and then says nothing, the way
       a joining game does in its first instant. It is not the game, it cannot log in, and it
       never becomes a player. It exists so the idle saver's wake-up can be watched from the
       server side without anybody joining in game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SkipBuildPathLeakCheck>true</SkipBuildPathLeakCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.0.1" />
  </ItemGroup>
</Project>
